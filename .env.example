# ===== Server =====
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# ===== Database (PostgreSQL) =====
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/chitralai?schema=public"

# ===== Google Gemini AI =====
# Get a key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# Free tier — see https://ai.google.dev/pricing for quotas
GEMINI_MODEL=gemini-2.5-flash

# ===== Cloudinary =====
# Get from https://console.cloudinary.com/ -> Dashboard
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=chitralai/resumes

# ===== Upload limits =====
MAX_FILE_SIZE_MB=10
